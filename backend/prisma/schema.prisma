generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  org_id String @id
  name String
  org_type String
  created_at String
  @@map("organizations")
}

model User {
  user_id String @id
  name String
  email String @unique
  username String? @unique
  password_hash String?
  mfa_enabled Int @default(0)
  mfa_secret String?
  created_at String
  @@map("users")
}

model Role {
  role_id String @id
  role_name String @unique
  @@map("roles")
}

model UserRole {
  user_id String
  role_id String
  site_id String?
  @@id([user_id, role_id])
  @@map("user_roles")
}

model Study {
  study_id String @id
  org_id String
  title String
  ctri_reg_number String?
  phase String
  therapeutic_area String
  status String
  start_date String
  end_date String?
  created_by String
  created_at String
  updated_at String
  @@map("studies")
}

model Site {
  site_id String @id
  study_id String
  name String
  location String
  lat Float?
  lng Float?
  pi_user_id String
  @@map("sites")
}

model Subject {
  subject_id String @id
  site_id String
  enrollment_status String
  enrollment_date String
  dosha_profile String?
  created_at String
  @@map("subjects")
}

model SubjectPii {
  subject_id String @id
  full_name_encrypted String
  contact_encrypted String
  abdm_health_id String?
  @@map("subject_pii")
}

model Document {
  document_id String @id
  entity_type String
  entity_id String
  file_ref String
  version String
  uploaded_by String
  uploaded_at String
  @@map("documents")
}

model Consent {
  consent_id String @id
  subject_id String
  version String
  signed_date String
  document_ref String
  @@map("consents")
}

model EcrfEntry {
  entry_id String @id
  subject_id String
  form_type String
  visit_number Int
  entered_by String
  entered_at String
  status String
  @@map("ecrf_entries")
}

model EcrfFieldValue {
  value_id String @id
  entry_id String
  field_name String
  field_value String
  sdtm_domain String?
  sdtm_variable String?
  @@map("ecrf_field_values")
}

model DeadlineRule {
  rule_id String @id
  event_type String
  deadline_offset_hours Int
  escalation_thresholds_pct String
  escalation_chain String
  version Int @default(1)
  active Int @default(1)
  @@map("deadline_rules")
}

model AeEvent {
  ae_id String @id
  subject_id String
  study_id String
  event_type String
  severity String
  causality String
  onset_datetime String
  description String
  reported_by String
  report_deadline String
  status String
  escalation_level Int @default(0)
  created_at String
  @@index([study_id, status])
  @@index([report_deadline])
  @@map("ae_events")
}

model EscalationLog {
  escalation_id String @id
  ae_id String
  level Int
  notified_role String
  notified_at String
  resolved Int @default(0)
  @@map("escalation_logs")
}

model IecReview {
  review_id String @id
  study_id String
  reviewer_id String
  decision String
  comments String?
  decision_date String
  e_signature_ref String?
  @@map("iec_reviews")
}

model ProtocolDeviation {
  deviation_id String @id
  study_id String
  reported_by String
  description String
  severity String
  status String
  reported_at String
  @@map("protocol_deviations")
}

model ComplianceScore {
  score_id String @id
  study_id String
  checkpoint String
  status String
  computed_at String
  @@map("compliance_scores")
}

model Milestone {
  milestone_id String @id
  study_id String
  name String
  planned_date String
  actual_date String?
  status String
  @@map("milestones")
}

model AuditLog {
  audit_id String @id
  actor_id String
  entity_type String
  entity_id String
  action String
  field String?
  old_value String?
  new_value String?
  prev_hash String
  record_hash String
  created_at String
  @@index([entity_type, entity_id, created_at])
  @@map("audit_logs")
}

model Notification {
  notification_id String @id
  user_id String
  type String
  message String
  read Int @default(0)
  created_at String
  @@map("notifications")
}
